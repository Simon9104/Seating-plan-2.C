# Database (libSQL / Turso client — see README for setup)
# Local dev: leave as-is, a local SQLite file is created automatically.
# Production (Vercel): MUST point to a hosted libSQL database, e.g. Turso.
#   Vercel Functions have an ephemeral/read-only filesystem, so "file:" URLs
#   do NOT persist in production — the app will refuse to start with a
#   "file:" DATABASE_URL outside local dev to prevent silent data loss.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Used once by `npm run setup:admin` to create the first admin account.
# Not read by the deployed app itself — safe to unset after first setup.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_NAME=Head Teacher
ADMIN_BOOTSTRAP_PASSWORD=change-this-to-a-long-random-passphrase
